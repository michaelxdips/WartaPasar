# Konfigurasi Ronce
# Salin file ini jadi .env lalu isi nilainya.
#
#   cp .env.example .env
#
# JANGAN commit file .env ke GitHub. Isinya rahasia.

# --- Sumber data: Sectors ---
# Dapatkan API key di https://sectors.app
SECTORS_API_KEY=

# --- AI untuk menulis ulang bahasa (opsional tapi disarankan) ---
# Pakai endpoint apa pun yang formatnya OpenAI-compatible.
# Contoh untuk beberapa provider populer:
#
#   OpenAI        : https://api.openai.com/v1        model: gpt-4o-mini
#   DeepSeek      : https://api.deepseek.com/v1      model: deepseek-chat
#   OpenRouter    : https://openrouter.ai/api/v1     model: meta-llama/llama-3.1-70b-instruct
#   Groq          : https://api.groq.com/openai/v1   model: llama-3.3-70b-versatile
#   Ollama lokal  : http://localhost:11434/v1        model: llama3.1
#   LM Studio     : http://localhost:1234/v1         model: local-model
#
RONCE_AI_BASE_URL=
RONCE_AI_API_KEY=
RONCE_AI_MODEL=

# --- Pengaturan tambahan (opsional) ---
# RONCE_OFFLINE=1          # paksa mode offline (pakai arsip)
# RONCE_OUT_DIR=output     # folder hasil
# RONCE_AI_TIMEOUT=90      # detik
